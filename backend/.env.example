# Copy to .env and edit. Every value has a safe default for local use,
# except SESSION_SECRET which is REQUIRED when NODE_ENV=production.

NODE_ENV=development
# Local: 127.0.0.1 (only this machine). Docker / cloud platforms: 0.0.0.0
HOST=127.0.0.1
PORT=3000

# SQLite file. In Docker this lives on the /app/data volume.
DB_FILE=./data/spendwise.db

# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Allow new accounts to register. Turn off after you create yours.
# (If the database has no users yet, the first sign-up is always allowed.)
ALLOW_SIGNUP=true

# Number of reverse proxies in front of the app (Caddy/Nginx/Render = 1).
# Needed so rate limiting sees the real client IP.
TRUST_PROXY=0

# Session length in days (rolling).
SESSION_DAYS=14

# Time zone used to decide what "today" is for scheduled transactions and bills.
# Leave it unset to use the server's own zone (often UTC on hosting platforms, which can
# create a bill on the wrong day for you). Example: Asia/Kolkata
# TZ=Asia/Kolkata
